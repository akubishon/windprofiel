# Kopieer naar .env en vul je eigen KNMI EDR API-sleutel in.
# .env staat in .gitignore en wordt nooit gecommit.
KNMI_EDR_API_KEY=

# Website (src/, worker/, node scripts/dev.mjs): publieke client- en Firebase-sleutel
# (of WP Fryslân.apk in de bovenliggende map) en een zelfgekozen lokaal sitewachtwoord.
WPF_PUBLIC_CLIENT_KEY=
WPF_FIREBASE_API_KEY=
SITE_PASSWORD=
